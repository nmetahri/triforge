#!/bin/bash
# Installs the i3-gnome environment: packages, i3blocks, i3-gnome and configuration files.

set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
source "${SCRIPT_DIR}/../lib/common.sh"

readonly PACKAGES=(
    "xorg" "i3-wm" "i3lock-fancy" "i3status" "dmenu" "fonts-hack-nerd"
    "feh" "flameshot" "bash-completion" "autoconf" "automake" "pkg-config"
    "light" "acpi" "blueman" "alsa-utils" "gnome-flashback" "zenity"
    "numlockx" "playerctl" "build-essential"
    "gdm3" "dbus-x11" "gnome-settings-daemon"
    "dex" "xautolock" "network-manager-gnome" "pulseaudio-utils" "autorandr"
    "gnome-power-manager" "git" "gnome-session" "gnome-keyring"
)
readonly I3BLOCKS_REPOSITORY="https://github.com/vivien/i3blocks"
readonly I3_GNOME_REPOSITORY="https://github.com/i3-gnome/i3-gnome.git"
readonly DISPLAY_MANAGER="gdm3"

show_help() {
    printf '%b\n' "${COLOR_BLUE}i3 Environment Setup and Configuration Installer${COLOR_RESET}

${COLOR_YELLOW}Usage:${COLOR_RESET}
    sudo ./install [OPTIONS]

${COLOR_YELLOW}Options:${COLOR_RESET}
    (no arguments)      Full installation: install packages, build i3blocks, setup config
    --update            Update only the i3 configuration files (no package installation)
    --update-config     Same as --update
    -h, --help          Show this help message

${COLOR_YELLOW}Notes:${COLOR_RESET}
    - This script must be run with sudo
    - Only works on Debian/Ubuntu-based systems
    - The --update option is useful when pulling updates from the repository"
}

copy_directory_to_user_config() {
    local source_directory="$1"
    local destination_directory="$2"
    run_as_target_user mkdir -p "$destination_directory"
    cp -r "$source_directory/"* "$destination_directory"
    chown -R "$SUDO_USER:$SUDO_USER" "$destination_directory"
}

setup_i3_config() {
    print_info "Setting up i3 configuration..."
    copy_directory_to_user_config "${SCRIPT_DIR}/configuration" "${TARGET_HOME}/.config/i3"
    print_success "i3 configuration copied"
}

setup_i3blocks() {
    print_info "Setting up i3blocks configuration..."
    copy_directory_to_user_config "${SCRIPT_DIR}/i3blocks" "${TARGET_HOME}/.config/i3blocks"
    print_success "i3blocks configuration copied"
}

setup_configuration() {
    setup_i3_config
    setup_i3blocks
}

update_configuration() {
    if [ ! -d "${TARGET_HOME}/.config/i3" ]; then
        print_error "i3 is not installed in ${TARGET_HOME}/.config/i3"
        print_warning "Please run a fresh installation first: sudo ./install"
        exit 1
    fi
    setup_configuration
    print_success "i3 configuration updated successfully!"
    print_info "Reload your i3 config with: \$mod+shift+c"
}

confirm_package_installation() {
    print_warning "The following packages will be installed:"
    printf '  - %s\n' "${PACKAGES[@]}"
    if ! ask_confirmation "Do you agree to install these packages?"; then
        print_warning "Installation aborted."
        exit 1
    fi
}

build_from_source() {
    local repository="$1"
    local directory_name="$2"
    shift 2
    git clone "$repository" "$directory_name"
    (cd "$directory_name" && "$@")
}

build_external_projects() {
    BUILD_DIRECTORY="$(mktemp -d)"
    trap 'rm -rf "$BUILD_DIRECTORY"' EXIT
    cd "$BUILD_DIRECTORY"

    print_info "Installing i3blocks (git version)..."
    build_from_source "$I3BLOCKS_REPOSITORY" i3blocks sh -c './autogen.sh && ./configure && make && make install'
    print_success "i3blocks installed"

    print_info "Configuring Gnome sessions to work with i3..."
    build_from_source "$I3_GNOME_REPOSITORY" i3-gnome make install
    print_success "i3-gnome integration configured"

    cd /
}

configure_gnome() {
    print_info "Configuring Gnome settings..."
    # Disable gnome flashback desktop
    run_as_target_user dbus-launch gsettings set org.gnome.gnome-flashback desktop false
    # Fix hidden system tray icons
    run_as_target_user dbus-launch gsettings set org.gnome.gnome-flashback status-notifier-watcher false
}

enable_display_manager() {
    print_info "Enabling ${DISPLAY_MANAGER} service..."
    systemctl enable display-manager.service
    systemctl start display-manager.service
}

full_installation() {
    require_supported_distribution
    confirm_package_installation
    install_apt_packages "${PACKAGES[@]}"
    build_external_projects
    configure_gnome
    setup_configuration
    enable_display_manager
    print_success "i3 environment setup completed!"
    print_warning "Next steps:"
    echo "  1. Reboot your system"
    echo "  2. Select i3+gnome session at login screen"
}

main() {
    local update_mode=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --update|--update-config) update_mode=true ;;
            -h|--help) show_help; exit 0 ;;
            *) print_error "Unknown option: $1"; echo "Use --help for usage information"; exit 1 ;;
        esac
        shift
    done

    require_sudo
    TARGET_HOME="$(target_user_home)"
    readonly TARGET_HOME

    if [ "$update_mode" = true ]; then
        update_configuration
    else
        full_installation
    fi
}

main "$@"
